PORT=4000
# Comma-separated origins are supported (localhost and 127.0.0.1 on any port are allowed by default)
CORS_ORIGIN=http://localhost:5173
CACHE_TTL_SECONDS=120
# Absolute or relative path to DB file (relative to project root)
DATABASE_PATH=model/pipeline b/csrs_pipeline_b.db
# Root folder for auto-discovered artifacts (relative to project root)
ARTIFACT_ROOT=model
